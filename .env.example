# ================================================
# Platform-IRede — Variables d'environnement
# ================================================

# === KoboToolbox ===
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=your_kobo_api_token_here

# === Supabase (optionnel en dev, requis en prod) ===
# Créer un projet sur https://supabase.com
# Récupérer les clés dans Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# === Vercel Cron (synchronisation automatique) ===
# Générer une clé secrète : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Puis configurer dans Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=your_cron_secret_here

# --- Migrations de base de donnees (optionnel mais recommande) ---
# Connexion Postgres directe : Supabase > Settings > Database > Connection string > URI
# Permet a `npm run migrate` d'appliquer les migrations en transaction,
# sans aucune preparation manuelle.
# Contient un mot de passe : ne jamais versionner ni partager ce fichier.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@<host>:5432/postgres
